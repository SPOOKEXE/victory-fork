new file mode 100644
index 0000000..e57068c
--- /dev/null
+++ b/libs/vkd3d/victory_stats.h
@@ -0,0 +1,87 @@
+/*
+ * Counters of the memory allocator for VIctory's vkd3d view (F2), read
+ * through the d3d12core.dll export vkd3d_victory_memory_stats. Each index
+ * below is one uint64; the reader (crates/victory-gpu/src/vkd3dstat.rs)
+ * names the same indices. "Live" values go up and down, "since" values
+ * only up, "window" values are reset by each read.
+ */
+
+#ifndef __VKD3D_VICTORY_STATS_H
+#define __VKD3D_VICTORY_STATS_H
+
+#include <stdint.h>
+
+enum vkd3d_victory_stat
+{
+    VS_VERSION = 0,
+    /* vkAllocateMemory: calls, ns, longest ns (window), failed tries,
+     * successes on a later memory type than the first tried, of them
+     * device-local asked but not given (count, bytes). */
+    VS_ALLOC_CALLS, VS_ALLOC_NS, VS_ALLOC_NS_MAX, VS_ALLOC_FAILS, VS_ALLOC_LATER_TYPE,
+    VS_ALLOC_OFF_CARD, VS_ALLOC_OFF_CARD_BYTES,
+    /* vkFreeMemory: calls, ns. */
+    VS_FREE_CALLS, VS_FREE_NS,
+    /* Suballocation (vkd3d_suballocate_memory): calls, ns, longest ns
+     * (window), ns waiting for the allocator's lock, chunks looked at,
+     * calls that made a new chunk, calls that found no room at all. */
+    VS_SUB_CALLS, VS_SUB_NS, VS_SUB_NS_MAX, VS_SUB_LOCK_NS, VS_SUB_CHUNKS_SEEN, VS_SUB_NEW_CHUNK, VS_SUB_FAILED,
+    /* Suballocations given back: calls, ns (lock included). */
+    VS_SUBFREE_CALLS, VS_SUBFREE_NS,
+    /* Clears queued on the transfer queue (count, bytes), CPU clears of
+     * mapped memory (count, bytes), waits for a clear (count, ns). */
+    VS_CLEARS, VS_CLEAR_BYTES, VS_CPU_CLEARS, VS_CPU_CLEAR_BYTES, VS_CLEAR_WAITS, VS_CLEAR_WAIT_NS,
+    /* Chunks made and given back since the start. */
+    VS_CHUNKS_MADE, VS_CHUNKS_FREED,
+    /* Live allocations by kind, count then bytes: buffers suballocated,
+     * buffers of their own, textures suballocated, textures of their own,
+     * heaps suballocated, heaps of their own, internal scratch. */
+    VS_KIND_BASE = 32,
+    VS_KIND_COUNT = 7,
+    /* Live device memory by Vulkan memory type, count then bytes. */
+    VS_TYPE_BASE = VS_KIND_BASE + 2 * VS_KIND_COUNT,
+    VS_TYPE_COUNT = 16,
+    /* Filled at read: each memory type's property flags and heap index. */
+    VS_TYPE_INFO_BASE = VS_TYPE_BASE + 2 * VS_TYPE_COUNT,
+    /* Filled at read: each memory heap's budget, use (the driver's) and
+     * size, and the number of heaps and types. */
+    VS_HEAP_BASE = VS_TYPE_INFO_BASE + 2 * VS_TYPE_COUNT,
+    VS_HEAP_COUNT = 4,
+    VS_HEAPS = VS_HEAP_BASE + 3 * VS_HEAP_COUNT,
+    VS_TYPES,
+    /* Filled at read, walking the chunks under the allocator's lock, for
+     * buffer chunks then texture chunks: chunks, their bytes, free bytes in
+     * them, free ranges, the largest free range, chunks with nothing free,
+     * chunks under a quarter used. */
+    VS_WALK_BASE,
+    VS_WALK_FIELDS = 7,
+    /* Free ranges in all chunks by length (under 64 KiB, 256 KiB, 1 MiB,
+     * 4 MiB, more), count then bytes. */
+    VS_HOLE_BASE = VS_WALK_BASE + 2 * VS_WALK_FIELDS,
+    VS_HOLE_BUCKETS = 5,
+    VS_WALK_NS = VS_HOLE_BASE + 2 * VS_HOLE_BUCKETS,
+    VS_COUNT,
+};
+
+#define VKD3D_VICTORY_STATS_VERSION 1
+
+extern uint64_t vkd3d_victory_stats[VS_COUNT];
+
+static inline void vkd3d_victory_add(enum vkd3d_victory_stat i, uint64_t v)
+{
+    __atomic_fetch_add(&vkd3d_victory_stats[i], v, __ATOMIC_RELAXED);
+}
+
+static inline void vkd3d_victory_sub(enum vkd3d_victory_stat i, uint64_t v)
+{
+    __atomic_fetch_sub(&vkd3d_victory_stats[i], v, __ATOMIC_RELAXED);
+}
+
+static inline void vkd3d_victory_max(enum vkd3d_victory_stat i, uint64_t v)
+{
+    uint64_t old = __atomic_load_n(&vkd3d_victory_stats[i], __ATOMIC_RELAXED);
+    while (v > old && !__atomic_compare_exchange_n(&vkd3d_victory_stats[i], &old, v, true,
+            __ATOMIC_RELAXED, __ATOMIC_RELAXED))
+        ;
+}
+
+#endif
