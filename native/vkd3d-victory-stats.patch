+
+/* For VIctory's vkd3d view (F2): copies up to `count` of the counters in
+ * victory_stats.h into `out`, after filling the ones taken at read (memory
+ * types and heaps, the walk over the chunks); the longest-call counters
+ * start again. Returns how many counters there are. */
+uint32_t vkd3d_victory_memory_stats(ID3D12Device *iface, uint64_t *out, uint32_t count)
+{
+    struct d3d12_device *device = impl_from_ID3D12Device((d3d12_device_iface *)iface);
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    struct vkd3d_memory_allocator *allocator = &device->memory_allocator;
+    uint64_t walk[2][VS_WALK_FIELDS], holes[2 * VS_HOLE_BUCKETS];
+    uint64_t began = vkd3d_get_current_time_ns();
+    uint32_t i, j;
+    size_t c, r;
+
+    vkd3d_victory_stats[VS_VERSION] = VKD3D_VICTORY_STATS_VERSION;
+    for (i = 0; i < device->memory_properties.memoryTypeCount && i < VS_TYPE_COUNT; i++)
+    {
+        vkd3d_victory_stats[VS_TYPE_INFO_BASE + 2 * i] = device->memory_properties.memoryTypes[i].propertyFlags;
+        vkd3d_victory_stats[VS_TYPE_INFO_BASE + 2 * i + 1] = device->memory_properties.memoryTypes[i].heapIndex;
+    }
+    vkd3d_victory_stats[VS_TYPES] = device->memory_properties.memoryTypeCount;
+
+    if (device->vk_info.EXT_memory_budget)
+    {
+        VkPhysicalDeviceMemoryBudgetPropertiesEXT budget_info;
+        VkPhysicalDeviceMemoryProperties2 props2;
+
+        props2.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2;
+        props2.pNext = &budget_info;
+        memset(&budget_info, 0, sizeof(budget_info));
+        budget_info.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT;
+        VK_CALL(vkGetPhysicalDeviceMemoryProperties2(device->vk_physical_device, &props2));
+        for (i = 0; i < props2.memoryProperties.memoryHeapCount && i < VS_HEAP_COUNT; i++)
+        {
+            vkd3d_victory_stats[VS_HEAP_BASE + 3 * i] = budget_info.heapBudget[i];
+            vkd3d_victory_stats[VS_HEAP_BASE + 3 * i + 1] = budget_info.heapUsage[i];
+            vkd3d_victory_stats[VS_HEAP_BASE + 3 * i + 2] = props2.memoryProperties.memoryHeaps[i].size;
+        }
+        vkd3d_victory_stats[VS_HEAPS] = props2.memoryProperties.memoryHeapCount;
+    }
+
+    memset(walk, 0, sizeof(walk));
+    memset(holes, 0, sizeof(holes));
+    pthread_mutex_lock(&allocator->mutex);
+    for (c = 0; c < allocator->chunks_count; c++)
+    {
+        const struct vkd3d_memory_chunk *chunk = allocator->chunks[c];
+        /* Texture chunks clear through a buffer used only as a copy's
+         * destination; buffer chunks hold buffers. */
+        uint64_t *w = walk[chunk->allocation.explicit_global_buffer_usage == VK_BUFFER_USAGE_TRANSFER_DST_BIT];
+        uint64_t size = chunk->allocation.resource.size, free = 0, largest = 0;
+
+        for (r = 0; r < chunk->free_ranges_count; r++)
+        {
+            uint64_t length = chunk->free_ranges[r].length;
+            uint32_t bucket = length < (64u << 10) ? 0 : length < (256u << 10) ? 1 :
+                    length < (1u << 20) ? 2 : length < (4u << 20) ? 3 : 4;
+            free += length;
+            if (length > largest)
+                largest = length;
+            holes[2 * bucket]++;
+            holes[2 * bucket + 1] += length;
+        }
+        w[0]++;
+        w[1] += size;
+        w[2] += free;
+        w[3] += chunk->free_ranges_count;
+        if (largest > w[4])
+            w[4] = largest;
+        if (!free)
+            w[5]++;
+        if (size - free < size / 4)
+            w[6]++;
+    }
+    pthread_mutex_unlock(&allocator->mutex);
+
+    for (i = 0; i < 2; i++)
+        for (j = 0; j < VS_WALK_FIELDS; j++)
+            vkd3d_victory_stats[VS_WALK_BASE + VS_WALK_FIELDS * i + j] = walk[i][j];
+    for (i = 0; i < 2 * VS_HOLE_BUCKETS; i++)
+        vkd3d_victory_stats[VS_HOLE_BASE + i] = holes[i];
+    vkd3d_victory_stats[VS_WALK_NS] = vkd3d_get_current_time_ns() - began;
+
+    for (i = 0; i < count && i < VS_COUNT; i++)
+        out[i] = __atomic_load_n(&vkd3d_victory_stats[i], __ATOMIC_RELAXED);
+    __atomic_store_n(&vkd3d_victory_stats[VS_ALLOC_NS_MAX], 0, __ATOMIC_RELAXED);
+    __atomic_store_n(&vkd3d_victory_stats[VS_SUB_NS_MAX], 0, __ATOMIC_RELAXED);
+    return VS_COUNT;
+}
